# Cloudflare Turnstile Human Verification
# Free, hosted CAPTCHA — create a widget at https://dash.cloudflare.com (Turnstile)
# and set its hostname to your site. SITE_KEY is NEXT_PUBLIC_* = inlined at BUILD
# time (rebuild after changing); SECRET_KEY is read by the server at runtime.
# Public site key from the Turnstile dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret key (do NOT prefix with NEXT_PUBLIC)
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (file uploads, S3-compatible)
# Files upload straight from the browser to R2 via presigned PUT URLs (bypasses the
# 4.5MB function body limit); the server only signs URLs and never proxies file bytes.
# Create a bucket + an "Object Read & Write" API token (R2 > Manage R2 API Tokens),
# and set the bucket CORS to allow PUT from your site origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email Notification (Resend)
# Server-only API key from https://resend.com/api-keys
RESEND_API_KEY=
# Recipient of inquiry notifications
CONTACT_EMAIL_TO=jay@biteerbags.com
# Sender address. For quick dev testing keep onboarding@resend.dev — note it can
# ONLY deliver to the Resend account owner's email. For production use an address
# on your verified domain (e.g. inquiry@betterbagsmm.com).
CONTACT_EMAIL_FROM=onboarding@resend.dev
# Sender for the auto-acknowledgment sent to the customer (verified-domain address;
# defaults to no-reply@betterbagsmm.com). Localized by the customer's submission locale.
CONTACT_ACK_FROM=no-reply@betterbagsmm.com

# Site base URL — SEO metadata / sitemap / Open Graph (NEXT_PUBLIC_, build-time)
NEXT_PUBLIC_BASE_URL=https://betterbagsmm.com

# Cal.com booking link for the Virtual Factory Tour page (NEXT_PUBLIC_, build-time)
# Format: "<cal-username>/<event-slug>", e.g. better-bags/virtual-factory-tour
# Setup guide: docs/CAL_COM_SETUP.md. When empty, the page shows a
# WhatsApp/email fallback card instead of the booking calendar.
NEXT_PUBLIC_CAL_LINK=

# Visitor analytics (NEXT_PUBLIC_, build-time). Both are optional: leave a value
# empty and that vendor is simply not loaded, so local dev and preview builds do
# not pollute production data.
#
# Neither script is loaded for visitors in mainland China (googletagmanager.com is
# blocked and clarity.ms is unreliable there), and in the EEA / UK / Switzerland
# both start with consent denied until the visitor accepts the consent banner.
#
# Google Analytics 4 Measurement ID, from the GA4 property ("G-" prefix).
# Link the property to Search Console — that is the main reason we run GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID, from https://clarity.microsoft.com
# Clarity supplies the scroll and click heatmaps and the session recordings.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Self-hosted visitor analytics (phase 2). All server-side; none of these are
# NEXT_PUBLIC_, so none of them reach the browser.
#
# Neon Postgres connection string. Provisioned automatically when you connect
# the Neon database to the project in the Vercel dashboard (Storage -> Neon ->
# Connect Project). Run `npm run analytics:migrate` once after connecting.
# Leave empty and the whole pipeline goes quiet: nothing is collected, and the
# dashboard explains what is missing.
DATABASE_URL=
# Secret used to derive the daily salt for visitor fingerprints. Any long random
# string. Rotating it severs all historical correlation, which is the intended
# emergency lever. Missing value means nothing is recorded at all -- the code
# never falls back to an unsalted hash.
ANALYTICS_SALT_SECRET=
# HTTP Basic credentials for /admin/analytics. Missing password means every
# request is rejected; the dashboard never becomes public by accident.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Vercel sends this automatically as `Authorization: Bearer <value>` when it
# invokes the cron jobs declared in vercel.json. Missing value means both cron
# endpoints reject everything.
CRON_SECRET=
# Where the weekly analytics report is sent. Falls back to CONTACT_EMAIL_TO.
ANALYTICS_REPORT_TO=

# Translation toolchain (Gemini) — used ONLY by local scripts/translate/*,
# never by the website build or runtime. Create a key at https://aistudio.google.com
GEMINI_API_KEY=
# Model used for translation / back-translation / cross-review
GEMINI_MODEL=gemini-3.1-pro-preview
